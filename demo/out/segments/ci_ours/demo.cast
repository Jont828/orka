[95.553, "o", "\r\n"]
[95.803, "o", "fix(deploy): use 3600 seconds per hour in parse_duration\r\n\r\n_UNIT_SECONDS mapped \"h\" to 360 instead of 3600, so any duration with an\r\nhours component came out 10x too short for that component (2h -> 720,\r\n1h30m -> 2160, 1h0m5s -> 365). This failed the orka-demo-ci\r\n\"deploy-utils unit tests\" check on 7abca60.\r\n\r\nAutomated-by: pr-shepherd\r\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>\r\nSigned-off-by: Jonathan Tong <jt572@cornell.edu>\r\n@@ -22,7 +22,7 @@\r\n import re\r\n \r\n # Seconds per unit.\r\n-_UNIT_SECONDS = {\"h\": 360, \"m\": 60, \"s\": 1}\r\n+_UNIT_SECONDS = {\"h\": 3600, \"m\": 60, \"s\": 1}\r\n \r\n # Each unit at most once, largest first: \"1h30m\" and \"90s\", not \"30m1h\".\r\n _DURATION = re.compile(r\"(?:(?P<h>\\d+)h)?(?:(?P<m>\\d+)m)?(?:(?P<s>\\d+)s)?\")\r\n"]
