[505.191, "o", "- #13 (head acb0ab8): no merge conflict; 1 failed check (1 new)\r\n"]
[505.191, "o", "[bootstrap 18:45:03] installing gh 2.103.3, uv 0.13.7, copilot 1.0.105\r\n"]
