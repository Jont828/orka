[114.3898, "o", "  \u001b[38;5;252mAdds \u001b[m\u001b[38;5;203;48;5;236m deploy/utils/quantity.py \u001b[m\u001b[38;5;252m, a small parser for Kubernetes resource quantities, so\u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\r\n"]
[114.3898, "o", "  \u001b[38;5;252mbenchmarking tooling can compare requested CPU and memory with node capacity without shelling\u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\u001b[38;5;252m \u001b[m\r\n"]
