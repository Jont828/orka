[0.022464, "o", "07a80bb refactor(deploy): drop single-letter tokens from _YAML11_AMBIGUOUS\r\n\r\nPyYAML loads y and n as plain strings, so force-quoting them only adds noise to converted manifests.\r\n\r\nSigned-off-by: Jonathan Tong <jt572@cornell.edu>\r\n\r\n\r\ndiff --git a/deploy/utils/convert_api_version.py b/deploy/utils/convert_api_version.py\r\nindex 6960e08..3228dde 100644\r\n--- a/deploy/utils/convert_api_version.py\r\n+++ b/deploy/utils/convert_api_version.py\r\n@@ -270,17 +270,13 @@ def default_webhook_fn(review: dict, kind: str) -> dict:\r\n \r\n # Strings a YAML 1.1 parser (go-yaml, used by kubectl and the apiserver) reads\r\n # as bool/null. PyYAML's emitter does not quote all of these on output (notably\r\n-# y/n/Y/N), so an unquoted value would be re-parsed as a bool and violate the\r\n+# yes/no/on/off), so an unquoted value would be re-parsed as a bool and violate the\r\n # \"value must be a string\" contract for e.g. container env vars. Force-quote them.\r\n _YAML11_AMBIGUOUS = frozenset(\r\n     {\r\n-        \"y\",\r\n-        \"Y\",\r\n         \"yes\","]
[0.022477, "o", "\r\n         \"Yes\",\r\n         \"YES\",\r\n-        \"n\",\r\n-        \"N\",\r\n         \"no\",\r\n         \"No\",\r\n         \"NO\",\r\n"]
[0.023104, "x", "0"]
